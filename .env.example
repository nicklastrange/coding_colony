# Generated by ./install.sh. Copy to .env or let the installer create it.

# Workspace containing target repositories.
ROOT_DIR=

# Installed path of this agentic setup.
AGENT_ROOT=

# Comma-separated harnesses generated for this install.
AGENT_HARNESSES=codex,claude,opencode

# Provider profile from config/providers.json.
AGENT_PROVIDER=codex-native

# Model tier mappings. Agent definitions refer to tiers; harness runtime config
# resolves those tiers to concrete provider/model IDs.
AGENT_MODEL_FAST=
AGENT_MODEL_BALANCED=
AGENT_MODEL_DEEP=
AGENT_MODEL_DESIGN=
AGENT_MODEL_REVIEW=

# Optional plugin names from config/plugins.json.
AGENT_PLUGINS=

# Installer-detected optional dependency status, used by generated init context.
# Format: plugin=enabled|disabled:available|missing|builtin[:path]
AGENT_OPTIONAL_DEPS=
AGENT_DETECTED_TOOLS=

# Optional plugin installation outcomes, such as graphify=installed or
# graphify=skipped.
AGENT_PLUGIN_INSTALLS=

# Optional gateway/provider secrets. Do not commit real values.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Optional MCP command overrides.
CONTEXT_MODE_COMMAND=context-mode
PLAYWRIGHT_MCP_COMMAND=playwright-mcp
GRAPHIFY_COMMAND=graphify
